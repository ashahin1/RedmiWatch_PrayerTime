{
  "package": "com.muslim.prayertimes",
  "name": "Prayer Times",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    { "name": "system.router" },
    { "name": "system.storage" },
    { "name": "system.geolocation" },
    { "name": "system.vibrator" },
    { "name": "system.device" },
    { "name": "system.alarm" },
    { "name": "system.prompt" }
  ],
  "permissions": [
    { "origin": "*" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 466
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/qibla": {
        "component": "qibla"
      },
      "pages/settings": {
        "component": "settings"
      }
    }
  }
}