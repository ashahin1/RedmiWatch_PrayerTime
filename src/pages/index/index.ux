  color: #FFFFFF;
  font-weight: bold;
}

/* Action Buttons */
.action-grid {
  width: 100%;
  justify-content: space-between;
  margin-top: 16px;
  margin-bottom: 14px;
}

.action-btn {
  width: 48%;
  height: 64px;
  border-radius: 20px;
  justify-content: center;
  align-items: center;
  border: 1px solid #374151;
}

