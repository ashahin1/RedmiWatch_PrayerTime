  margin-right: 8px;
}

.countdown-timer {
  font-size: 32px;
  color: #34D399;
  font-weight: bold;
}

.progress-track {
  width: 100%;
  height: 8px;
  background-color: #374151;
  border-radius: 4px;
}

.progress-fill {
  height: 8px;
  background-color: #10B981;
  border-radius: 4px;
}

/* Section Title */
.section-box {
  width: 100%;
  padding-top: 10px;
  padding-bottom: 10px;
}

.section-title {
  font-size: 20px;
  color: #6B7280;
  font-weight: bold;
}

/* Prayer Rows */
.prayer-row {
  width: 100%;
  padding-left: 18px;
  padding-right: 18px;
  padding-top: 14px;
  padding-bottom: 14px;
  margin-bottom: 8px;
  justify-content: space-between;
  align-items: center;
  border-radius: 16px;
  background-color: #0F172A;
