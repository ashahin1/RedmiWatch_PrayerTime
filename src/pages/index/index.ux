<template>
  <div class="page">
    <scroll class="scroll-container" scroll-y="true">
      <!-- 1. Header: Date, City, Time -->
      <div class="header-box">
        <text class="hijri-text">{{ hijriDateStr }}</text>
        <text class="location-badge">{{ cityName }}</text>
      </div>

      <!-- 2. Hero Next Prayer Card -->
      <div class="hero-card">
        <div class="hero-header">
          <text class="hero-label">NEXT PRAYER</text>
          <text class="hero-prayer-time">{{ nextPrayerTime }}</text>
        </div>
        <text class="hero-prayer-name">{{ nextPrayerName }}</text>
        <div class="countdown-row">
          <text class="countdown-label">in</text>
          <text class="countdown-timer">{{ countdownText }}</text>
        </div>
        <!-- Progress Bar -->
        <div class="progress-track">
          <div class="progress-fill" style="width: {{ progressWidth }}px;"></div>
        </div>
      </div>

      <!-- 3. Section Title -->
      <div class="section-box">
        <text class="section-title">TODAY'S SCHEDULE</text>
      </div>

      <!-- 4. Prayer Times List Items -->
      <div for="{{ prayerList }}" class="prayer-row {{ $item.isActive ? 'active-row' : '' }}">
        <div class="prayer-left">
          <div class="active-dot {{ $item.isActive ? 'dot-visible' : 'dot-hidden' }}"></div>
          <text class="prayer-name {{ $item.isActive ? 'active-text' : '' }}">{{ $item.name }}</text>
        </div>
        <text class="prayer-time {{ $item.isActive ? 'active-text' : '' }}">{{ $item.timeStr }}</text>
      </div>

      <!-- 5. Action Buttons -->
      <div class="action-grid">
        <div class="action-btn qibla-btn" onclick="openQibla">
          <text class="btn-text">🧭 Qibla</text>
        </div>
        <div class="action-btn settings-btn" onclick="openSettings">
          <text class="btn-text">⚙ Settings</text>
        </div>
      </div>

      <div class="footer-spacing">
        <text class="footer-note">Xiaomi Vela • Redmi Watch 6</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router';
import vibrator from '@system.vibrator';
import { PrayerEngine } from '../../common/prayer-engine.js';
import { getHijriDate } from '../../common/hijri.js';
import { loadSettings, DEFAULT_SETTINGS } from '../../common/storage.js';

export default {
  data: {
    cityName: 'Riyadh',
    hijriDateStr: '',
    nextPrayerName: '--',
    nextPrayerTime: '--:--',
    countdownText: '00:00:00',
    progressWidth: 0,
    prayerList: [],
    timerId: null,
    settings: null,
    schedule: null,
    lastAlertedPrayer: ''
  },

  onInit() {
    console.log('[PrayerApp] index.ux onInit starting');
    this.initSynchronousData();
    this.refreshAll();
  },

  onShow() {
    console.log('[PrayerApp] index.ux onShow');
    this.refreshAll();
    this.startTicker();
  },

  onHide() {
    this.stopTicker();
  },

  onDestroy() {
    this.stopTicker();
  },

  initSynchronousData() {
    if (!this.settings) {
      this.settings = Object.assign({}, DEFAULT_SETTINGS);
    }
    this.computeAndApplySchedule();
  },

  async refreshAll() {
    try {
      const loaded = await loadSettings();
      if (loaded) {
        this.settings = loaded;
      }
    } catch (e) {
      console.log('[PrayerApp] loadSettings error:', e);
    }
    this.computeAndApplySchedule();
  },

  computeAndApplySchedule() {
    if (!this.settings) return;
    this.cityName = this.settings.cityName || 'Riyadh';

    const now = new Date();
    const hijri = getHijriDate(now, this.settings.hijriAdjustment || 0);
    this.hijriDateStr = hijri.formattedEn;

    const engine = new PrayerEngine({
      method: this.settings.method,
      asrRule: this.settings.asrRule,
      highLatitudeRule: this.settings.highLatitudeRule,
      offsets: this.settings.offsets,
      timeFormat: this.settings.timeFormat || '12h'
    });

    const tz = (typeof this.settings.timezone === 'number')
      ? this.settings.timezone
      : Math.round((this.settings.longitude || 46.6753) / 15.0);

    this.schedule = engine.calculate(
      now,
      this.settings.latitude,
      this.settings.longitude,
      tz,
      hijri.isRamadan
    );

    console.log(`[PrayerApp] Computed for ${this.cityName} (tz=${tz}): Fajr=${this.schedule.fajr.timeStr}, Dhuhr=${this.schedule.dhuhr.timeStr}, Asr=${this.schedule.asr.timeStr}, Maghrib=${this.schedule.maghrib.timeStr}, Isha=${this.schedule.isha.timeStr}`);

    this.updateTick();
  },

  startTicker() {
    this.stopTicker();
    this.timerId = setInterval(() => {
      this.updateTick();
    }, 1000);
  },

  stopTicker() {
    if (this.timerId) {
      clearInterval(this.timerId);
      this.timerId = null;
    }
  },

  updateTick() {
    if (!this.schedule || !this.settings) return;

    const now = new Date();
    const engine = new PrayerEngine({
      method: this.settings.method,
      asrRule: this.settings.asrRule,
      highLatitudeRule: this.settings.highLatitudeRule,
      offsets: this.settings.offsets,
      timeFormat: this.settings.timeFormat || '12h'
    });

    const info = engine.getNextPrayer(this.schedule, now);

    this.nextPrayerName = info.nextPrayer.name;
    this.nextPrayerTime = info.nextPrayer.time.timeStr;
    this.countdownText = info.countdownStr;

    // Progress bar width (max 330px inside 370px card)
    const maxWidth = 330;
    this.progressWidth = Math.round((info.progressPercent / 100) * maxWidth);

    // Build timeline list
    const activeKey = info.currentPrayer ? info.currentPrayer.key : '';
    this.prayerList = [
      { key: 'fajr', name: 'Fajr', timeStr: this.schedule.fajr.timeStr, isActive: activeKey === 'fajr' },
      { key: 'sunrise', name: 'Sunrise', timeStr: this.schedule.sunrise.timeStr, isActive: activeKey === 'sunrise' },
      { key: 'dhuhr', name: 'Dhuhr', timeStr: this.schedule.dhuhr.timeStr, isActive: activeKey === 'dhuhr' },
      { key: 'asr', name: 'Asr', timeStr: this.schedule.asr.timeStr, isActive: activeKey === 'asr' },
      { key: 'maghrib', name: 'Maghrib', timeStr: this.schedule.maghrib.timeStr, isActive: activeKey === 'maghrib' },
      { key: 'isha', name: 'Isha', timeStr: this.schedule.isha.timeStr, isActive: activeKey === 'isha' }
    ];

    // Check if prayer time arrived (countdown reached 0)
    if (info.totalDiffSec === 0 && this.lastAlertedPrayer !== info.nextPrayer.key) {
      this.lastAlertedPrayer = info.nextPrayer.key;
      if (this.settings.vibrateOnAdhan) {
        try {
          vibrator.vibrate({ mode: 'long' });
        } catch (e) {}
      }
    }
  },

  openQibla() {
    router.push({
      uri: '/pages/qibla'
    });
  },

  openSettings() {
    router.push({
      uri: '/pages/settings'
    });
  }
};
</script>

