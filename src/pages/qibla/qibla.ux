  width: 220px;
  height: 220px;
  border-radius: 110px;
  background-color: #1E293B;
  justify-content: center;
  align-items: center;
  position: relative;
}

.needle-container {
  width: 220px;
  height: 220px;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

