<template>
  <div class="page">
    <scroll class="scroll-container" scroll-y="true">
      <!-- Top Navigation -->
      <div class="nav-row">
        <text class="back-btn" onclick="goBack">◀ Back</text>
        <text class="nav-title">Qibla</text>
        <text class="nav-space"></text>
      </div>

      <!-- Bearing Display -->
      <div class="bearing-box">
        <text class="bearing-degrees">{{ qiblaBearing }}°</text>
        <text class="bearing-city">From {{ cityName }} to Kaaba</text>
      </div>

      <!-- Compass Visual Dial -->
      <div class="compass-wrap">
        <div class="compass-outer {{ isAligned ? 'compass-aligned' : '' }}">
          <div class="compass-inner">
            <!-- Center Direction Arrow / Needle -->
            <div class="needle-container" style="transform: rotate({{ needleRotation }}deg);">
              <div class="needle-tip"></div>
              <div class="needle-shaft"></div>
              <div class="needle-base"></div>
            </div>
            <!-- Kaaba Icon / Symbol -->
            <text class="kaaba-icon">🕋</text>
          </div>
        </div>
      </div>

      <!-- Alignment Feedback Status -->
      <div class="status-wrap">
        <div class="status-badge {{ isAligned ? 'badge-aligned' : 'badge-normal' }}">
          <text class="status-text">{{ isAligned ? '✓ Pointing towards Kaaba' : alignmentText }}</text>
        </div>
      </div>

      <!-- Distance and Coordinates Info -->
      <div class="info-card">
        <div class="info-row">
          <text class="info-label">Distance:</text>
          <text class="info-val">{{ distanceKm }} km</text>
        </div>
        <div class="info-row">
          <text class="info-label">Direction:</text>
          <text class="info-val">{{ qiblaBearing }}° True North</text>
        </div>
        <div class="info-row">
          <text class="info-label">Sensor:</text>
          <text class="info-val">{{ compassSupported ? 'Active' : 'Simulated' }}</text>
        </div>
      </div>

      <div class="footer-wrap">
        <text class="tip-text">Rotate wrist horizontally until the green circle lights up.</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router';
import sensor from '@system.sensor';
import vibrator from '@system.vibrator';
import { calculateQiblaDirection, calculateDistanceToKaaba, computeNeedleAngle } from '../../common/qibla.js';
import { loadSettings } from '../../common/storage.js';

export default {
  data: {
    cityName: 'Riyadh',
    qiblaBearing: 244,
    distanceKm: 790,
    needleRotation: 244,
    isAligned: false,
    alignmentText: 'Rotate to align',
    compassSupported: true,
    hasVibratedOnAlign: false
  },

  onInit() {
    this.initSyncData();
    this.refreshSettings();
  },

  onShow() {
    this.startCompass();
  },

  onHide() {
    this.stopCompass();
  },

  onDestroy() {
    this.stopCompass();
  },

  initSyncData() {
    const lat = 24.7136;
    const lon = 46.6753;
    this.qiblaBearing = calculateQiblaDirection(lat, lon);
    this.distanceKm = calculateDistanceToKaaba(lat, lon);
    this.needleRotation = this.qiblaBearing;
  },

  async refreshSettings() {
    try {
      const settings = await loadSettings();
      if (settings) {
        this.cityName = settings.cityName || 'Riyadh';
        const lat = settings.latitude || 24.7136;
        const lon = settings.longitude || 46.6753;
        this.qiblaBearing = calculateQiblaDirection(lat, lon);
        this.distanceKm = calculateDistanceToKaaba(lat, lon);
        this.needleRotation = this.qiblaBearing;
      }
    } catch (e) {
      console.log('[Qibla] refreshSettings error:', e);
    }
  },

  startCompass() {
    try {
      sensor.subscribeCompass({
        callback: (res) => {
          this.compassSupported = true;
          const angle = computeNeedleAngle(res.direction, this.qiblaBearing);
          this.needleRotation = angle;

          const aligned = Math.abs(angle) <= 6;
          this.isAligned = aligned;

          if (aligned) {
            this.alignmentText = 'Aligned!';
            if (!this.hasVibratedOnAlign) {
              this.hasVibratedOnAlign = true;
              try {
                vibrator.vibrate({ mode: 'short' });
              } catch (e) {}
            }
          } else {
            this.hasVibratedOnAlign = false;
            this.alignmentText = angle > 0 ? `Turn right ${Math.abs(angle)}°` : `Turn left ${Math.abs(angle)}°`;
          }
        },
        fail: (data, code) => {
          console.log('Compass not active or not supported in simulator:', code);
          this.compassSupported = false;
        },
        complete: () => {}
      });
    } catch (err) {
      console.log('Compass subscribe exception:', err);
      this.compassSupported = false;
    }
  },

  stopCompass() {
    try {
      sensor.unsubscribeCompass();
    } catch (e) {}
  },

  goBack() {
    router.back();
  }
};
</script>

