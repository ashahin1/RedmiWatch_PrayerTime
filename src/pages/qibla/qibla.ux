<template>
  <div class="page">
    <scroll class="scroll-container" scroll-y="true">
      <!-- Top Navigation -->
      <div class="nav-row">
        <text class="back-btn" onclick="goBack">◀ Back</text>
        <text class="nav-title">Qibla Direction</text>
        <text class="nav-space"></text>
      </div>

      <!-- Hero Bearing Card -->
      <div class="hero-card">
        <text class="hero-label">QIBLA BEARING</text>
        <text class="hero-bearing">{{ qiblaBearing }}°</text>
        <div class="cardinal-badge">
          <text class="cardinal-text">{{ cardinalCode }} • {{ cardinalLabel }}</text>
        </div>
        <text class="hero-sub">From {{ cityName }} to Holy Kaaba</text>
      </div>

      <!-- Alignment Guide -->
      <div class="guide-box">
        <div class="guide-header">
          <text class="guide-title">ORIENTATION GUIDE</text>
        </div>
        <div class="step-row">
          <text class="step-num">1</text>
          <text class="step-text">Face True North (0°)</text>
        </div>
        <div class="step-row">
          <text class="step-num">2</text>
          <text class="step-text">Turn {{ qiblaBearing }}° clockwise (towards {{ cardinalCode }})</text>
        </div>
        <div class="step-row">
          <text class="step-num">3</text>
          <text class="step-text">You are now facing the Holy Kaaba</text>
        </div>
      </div>

      <!-- 8-Point Compass Reference Grid -->
      <div class="section-box">
        <text class="section-title">COMPASS QUADRANT</text>
      </div>

      <div class="quadrant-grid">
        <div for="{{ compassPoints }}" class="point-cell {{ $item.isTarget ? 'cell-active' : '' }}">
          <text class="point-code {{ $item.isTarget ? 'text-active' : '' }}">{{ $item.code }}</text>
          <text class="point-deg {{ $item.isTarget ? 'text-active-sub' : '' }}">{{ $item.deg }}°</text>
          <text class="point-badge" if="{{ $item.isTarget }}">★ Qibla</text>
        </div>
      </div>

      <!-- Details Card -->
      <div class="details-card">
        <div class="detail-row">
          <text class="detail-label">Distance to Kaaba</text>
          <text class="detail-val">{{ distanceKm }} km</text>
        </div>
        <div class="detail-row">
          <text class="detail-label">Current City</text>
          <text class="detail-val">{{ cityName }}</text>
        </div>
        <div class="detail-row">
          <text class="detail-label">Coordinates</text>
          <text class="detail-val">{{ coordsStr }}</text>
        </div>
        <div class="detail-row">
          <text class="detail-label">Kaaba Target</text>
          <text class="detail-val">21.42° N, 39.83° E</text>
        </div>
      </div>

      <div class="footer-wrap">
        <text class="footer-note">Calculated via Great-Circle Spherical Trigonometry</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router';
import { calculateQiblaDirection, calculateDistanceToKaaba, getCardinalDirection } from '../../common/qibla.js';
import { loadSettings, getCachedSettings } from '../../common/storage.js';

export default {
  data: {
    cityName: '--',
    qiblaBearing: 0,
    distanceKm: 0,
    cardinalCode: '--',
    cardinalLabel: '--',
    coordsStr: '--',
    compassPoints: []
  },

  onInit() {
    this.initSyncData();
  },

  onShow() {
    this.refreshSettings();
  },

  initSyncData() {
    const cached = getCachedSettings();
    if (cached) {
      this.applyCoordinates(cached.latitude, cached.longitude, cached.cityName);
    }
  },

  async refreshSettings() {
    try {
      const settings = await loadSettings();
      if (settings) {
        const lat = settings.latitude || 24.7136;
        const lon = settings.longitude || 46.6753;
        const name = settings.cityName || 'Riyadh';
        this.applyCoordinates(lat, lon, name);
      }
    } catch (e) {
      console.log('[Qibla] refreshSettings error:', e);
    }
  },

  applyCoordinates(lat, lon, name) {
    this.cityName = name;
    this.qiblaBearing = calculateQiblaDirection(lat, lon);
    this.distanceKm = calculateDistanceToKaaba(lat, lon);

    const card = getCardinalDirection(this.qiblaBearing);
    this.cardinalCode = card.code;
    this.cardinalLabel = card.label;

    const latH = lat >= 0 ? 'N' : 'S';
    const lonH = lon >= 0 ? 'E' : 'W';
    this.coordsStr = `${Math.abs(lat).toFixed(2)}° ${latH}, ${Math.abs(lon).toFixed(2)}° ${lonH}`;

    this.buildCompassPoints(this.qiblaBearing);
  },

  buildCompassPoints(bearing) {
    const points = [
      { code: 'N', deg: 0, min: 337.5, max: 22.5 },
      { code: 'NE', deg: 45, min: 22.5, max: 67.5 },
      { code: 'E', deg: 90, min: 67.5, max: 112.5 },
      { code: 'SE', deg: 135, min: 112.5, max: 157.5 },
      { code: 'S', deg: 180, min: 157.5, max: 202.5 },
      { code: 'SW', deg: 225, min: 202.5, max: 247.5 },
      { code: 'W', deg: 270, min: 247.5, max: 292.5 },
      { code: 'NW', deg: 315, min: 292.5, max: 337.5 }
    ];

    const norm = (bearing % 360 + 360) % 360;

    this.compassPoints = points.map((p) => {
      let isTarget = false;
      if (p.code === 'N') {
        isTarget = norm >= 337.5 || norm < 22.5;
      } else {
        isTarget = norm >= p.min && norm < p.max;
      }
      return {
        code: p.code,
        deg: p.deg,
        isTarget
      };
    });
  },

  goBack() {
    router.back();
  }
};
</script>

