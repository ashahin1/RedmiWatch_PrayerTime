<template>
  <div class="page">
    <scroll class="scroll-container" scroll-y="true">
      <!-- Navigation Header -->
      <div class="nav-row">
        <text class="back-btn" onclick="goBack">◀ Back</text>
        <text class="nav-title">Settings</text>
        <text class="nav-space"></text>
      </div>

      <!-- GPS Section -->
      <div class="section-box">
        <text class="section-label">LOCATION & GPS</text>
      </div>

      <div class="card">
        <div class="card-header">
          <text class="card-title">Active: {{ currentCityName }}</text>
        </div>
        <text class="card-subtitle">{{ currentCoords }}</text>
        <div class="gps-btn" onclick="acquireGps">
          <text class="gps-btn-text">{{ gpsBtnText }}</text>
        </div>
        <div class="saved-gps-btn" if="{{ hasSavedGps && !isCurrentlyUsingGps }}" onclick="useSavedGps">
          <text class="saved-gps-text">📍 Use Saved GPS ({{ savedGpsCoords }})</text>
        </div>
        <text class="gps-status" if="{{ gpsStatusMsg }}">{{ gpsStatusMsg }}</text>
      </div>

      <!-- City Presets Section -->
      <div class="section-box">
        <text class="section-label">SELECT CITY PRESET</text>
      </div>

      <div for="{{ cityList }}" class="preset-row {{ $item.isSelected ? 'selected-row' : '' }}" onclick="selectCity($item)">
        <div class="city-info">
          <text class="city-name {{ $item.isSelected ? 'selected-text' : '' }}">{{ $item.name }}</text>
          <text class="city-country">{{ $item.country }}</text>
        </div>
        <text class="check-mark" if="{{ $item.isSelected }}">✓</text>
      </div>

      <!-- Calculation Method Section -->
      <div class="section-box">
        <text class="section-label">CALCULATION METHOD</text>
      </div>

      <div for="{{ methodList }}" class="preset-row {{ $item.isSelected ? 'selected-row' : '' }}" onclick="selectMethod($item.key)">
        <text class="method-name {{ $item.isSelected ? 'selected-text' : '' }}">{{ $item.name }}</text>
        <text class="check-mark" if="{{ $item.isSelected }}">✓</text>
      </div>

      <!-- Asr Juristic Rule Section -->
      <div class="section-box">
        <text class="section-label">ASR JURISTIC RULE</text>
      </div>

      <div for="{{ asrList }}" class="preset-row {{ $item.isSelected ? 'selected-row' : '' }}" onclick="selectAsr($item.key)">
        <text class="method-name {{ $item.isSelected ? 'selected-text' : '' }}">{{ $item.name }}</text>
        <text class="check-mark" if="{{ $item.isSelected }}">✓</text>
      </div>

      <!-- Time Format Section -->
      <div class="section-box">
        <text class="section-label">TIME FORMAT</text>
      </div>

      <div for="{{ timeFormatList }}" class="preset-row {{ $item.isSelected ? 'selected-row' : '' }}" onclick="selectTimeFormat($item.key)">
        <text class="method-name {{ $item.isSelected ? 'selected-text' : '' }}">{{ $item.name }}</text>
        <text class="check-mark" if="{{ $item.isSelected }}">✓</text>
      </div>

      <!-- Haptics Toggle Section -->
      <div class="section-box">
        <text class="section-label">HAPTICS & ALERTS</text>
      </div>

      <div class="toggle-row" onclick="toggleVibrate">
        <text class="toggle-label">Vibrate on Adhan</text>
        <div class="toggle-pill {{ vibrateOnAdhan ? 'pill-on' : 'pill-off' }}">
          <text class="pill-text">{{ vibrateOnAdhan ? 'ON' : 'OFF' }}</text>
        </div>
      </div>

      <div class="footer-wrap">
        <text class="footer-info">Redmi Watch 6 • Prayer Times v1.0.0</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router';
import geolocation from '@system.geolocation';
import vibrator from '@system.vibrator';
import { CITIES } from '../../common/cities.js';
import { loadSettings, saveSettings, DEFAULT_SETTINGS } from '../../common/storage.js';

export default {
  data: {
    settings: null,
    currentCityName: 'Riyadh',
    currentCoords: '24.71° N, 46.68° E',
    gpsBtnText: '📡 Sync Current GPS Location',
    gpsStatusMsg: '',
    hasSavedGps: false,
    savedGpsCoords: '',
    isCurrentlyUsingGps: false,
    vibrateOnAdhan: true,
    cityList: [],
    methodList: [],
    asrList: [],
    timeFormatList: []
  },

  onInit() {
    this.initSyncUI();
    this.refreshUI();
  },

  initSyncUI() {
    this.settings = Object.assign({}, DEFAULT_SETTINGS);
    this.updateLists();
  },

  async refreshUI() {
    try {
      const loaded = await loadSettings();
      if (loaded) {
        this.settings = loaded;
      }
    } catch (e) {
      console.log('[Settings] refreshUI load error:', e);
    }
    this.updateLists();
  },

  updateLists() {
    if (!this.settings) return;
    this.currentCityName = this.settings.cityName || 'Riyadh';
    const lat = typeof this.settings.latitude === 'number' ? this.settings.latitude : 24.7136;
    const lon = typeof this.settings.longitude === 'number' ? this.settings.longitude : 46.6753;
    const latH = lat >= 0 ? 'N' : 'S';
    const lonH = lon >= 0 ? 'E' : 'W';
    this.currentCoords = `${Math.abs(lat).toFixed(2)}° ${latH}, ${Math.abs(lon).toFixed(2)}° ${lonH}`;
    this.vibrateOnAdhan = !!this.settings.vibrateOnAdhan;

    const isGpsMode = this.settings.locationMode === 'gps' || this.settings.cityName === 'Current Location (GPS)';
    this.isCurrentlyUsingGps = isGpsMode;
    this.hasSavedGps = !!(this.settings.hasSavedGps && typeof this.settings.savedGpsLat === 'number');

    if (this.hasSavedGps) {
      const gLat = this.settings.savedGpsLat;
      const gLon = this.settings.savedGpsLon;
      const gLatH = gLat >= 0 ? 'N' : 'S';
      const gLonH = gLon >= 0 ? 'E' : 'W';
      this.savedGpsCoords = `${Math.abs(gLat).toFixed(2)}° ${gLatH}, ${Math.abs(gLon).toFixed(2)}° ${gLonH}`;
    }

    // Build time format options
    const timeFormats = [
      { key: '12h', name: '12-Hour (e.g. 03:04 PM)' },
      { key: '24h', name: '24-Hour (e.g. 15:04)' }
    ];
    this.timeFormatList = timeFormats.map(tf => ({
      ...tf,
      isSelected: tf.key === (this.settings.timeFormat || '12h')
    }));

    // Build city options: only marked selected if NOT in GPS mode
    this.cityList = CITIES.map(c => ({
      ...c,
      isSelected: !isGpsMode && (c.id === this.settings.selectedCityId || c.name.toLowerCase() === this.currentCityName.toLowerCase())
    }));

    // Build calculation method options
    const methods = [
      { key: 'UmmAlQura', name: 'Umm al-Qura (Makkah)' },
      { key: 'MWL', name: 'Muslim World League' },
      { key: 'Egypt', name: 'Egyptian General Authority' },
      { key: 'Karachi', name: 'Karachi (Hanafi)' },
      { key: 'Dubai', name: 'Dubai / UAE' },
      { key: 'ISNA', name: 'ISNA (North America)' }
    ];
    this.methodList = methods.map(m => ({
      ...m,
      isSelected: m.key === this.settings.method
    }));

    // Build Asr options
    const asrOptions = [
      { key: 'Standard', name: 'Standard (Shafi\'i/Maliki/Hanbali)' },
      { key: 'Hanafi', name: 'Hanafi' }
    ];
    this.asrList = asrOptions.map(a => ({
      ...a,
      isSelected: a.key === this.settings.asrRule
    }));
  },

  async selectTimeFormat(formatKey) {
    this.settings.timeFormat = formatKey;
    await saveSettings(this.settings);
    this.updateLists();

    try {
      vibrator.vibrate({ mode: 'short' });
    } catch (e) {}
  },

  async selectCity(city) {
    this.settings.cityName = city.name;
    this.settings.selectedCityId = city.id;
    this.settings.latitude = city.lat;
    this.settings.longitude = city.lon;
    this.settings.timezone = city.timezone !== undefined ? city.timezone : Math.round(city.lon / 15.0);
    this.settings.method = city.method;
    this.settings.asrRule = city.asrRule;
    this.settings.locationMode = 'preset';

    await saveSettings(this.settings);
    this.updateLists();

    try {
      vibrator.vibrate({ mode: 'short' });
    } catch (e) {}
  },

  async useSavedGps() {
    if (!this.settings || !this.settings.hasSavedGps) return;
    this.settings.latitude = this.settings.savedGpsLat;
    this.settings.longitude = this.settings.savedGpsLon;
    this.settings.timezone = this.settings.savedGpsTimezone !== undefined
      ? this.settings.savedGpsTimezone
      : Math.round(this.settings.savedGpsLon / 15.0);
    this.settings.cityName = 'Current Location (GPS)';
    this.settings.selectedCityId = 'gps';
    this.settings.locationMode = 'gps';

    await saveSettings(this.settings);
    this.updateLists();

    try {
      vibrator.vibrate({ mode: 'short' });
    } catch (e) {}
  },

  async selectMethod(methodKey) {
    this.settings.method = methodKey;
    await saveSettings(this.settings);
    this.updateLists();

    try {
      vibrator.vibrate({ mode: 'short' });
    } catch (e) {}
  },

  async selectAsr(asrKey) {
    this.settings.asrRule = asrKey;
    await saveSettings(this.settings);
    this.updateLists();

    try {
      vibrator.vibrate({ mode: 'short' });
    } catch (e) {}
  },

  async toggleVibrate() {
    this.vibrateOnAdhan = !this.vibrateOnAdhan;
    this.settings.vibrateOnAdhan = this.vibrateOnAdhan;
    await saveSettings(this.settings);

    try {
      vibrator.vibrate({ mode: 'short' });
    } catch (e) {}
  },

  acquireGps() {
    this.gpsBtnText = 'Locating GPS...';
    this.gpsStatusMsg = 'Searching for satellite fix...';

    try {
      geolocation.getLocation({
        timeout: 20000,
        success: async (data) => {
          this.settings.latitude = data.latitude;
          this.settings.longitude = data.longitude;
          this.settings.timezone = Math.round(data.longitude / 15.0);
          this.settings.cityName = 'Current Location (GPS)';
          this.settings.locationMode = 'gps';
          this.settings.selectedCityId = 'gps';

          // Persist the locked GPS location for later use
          this.settings.hasSavedGps = true;
          this.settings.savedGpsLat = data.latitude;
          this.settings.savedGpsLon = data.longitude;
          this.settings.savedGpsTimezone = this.settings.timezone;

          await saveSettings(this.settings);
          this.gpsBtnText = '📡 Sync Current GPS Location';
          this.gpsStatusMsg = `✓ GPS Locked (${data.latitude.toFixed(2)}°, ${data.longitude.toFixed(2)}°)`;
          this.updateLists();

          try {
            vibrator.vibrate({ mode: 'short' });
          } catch (e) {}
        },
        fail: (data, code) => {
          this.gpsBtnText = '📡 Sync Current GPS Location';
          this.gpsStatusMsg = `GPS signal unavailable (${code}). Using preset.`;
        },
        complete: () => {}
      });
    } catch (err) {
      this.gpsBtnText = '📡 Sync Current GPS Location';
      this.gpsStatusMsg = 'GPS service not available in emulator.';
    }
  },

  goBack() {
    router.back();
  }
};
</script>

<style>
