  font-size: 24px;
  color: #FFFFFF;
  font-weight: bold;
}

.card-subtitle {
  font-size: 20px;
  color: #9CA3AF;
  margin-top: 4px;
  margin-bottom: 12px;
}

.gps-btn {
  width: 100%;
  height: 56px;
  border-radius: 16px;
  background-color: #10B981;
  justify-content: center;
  align-items: center;
}

.gps-btn-text {
  color: #FFFFFF;
  font-size: 22px;
  font-weight: bold;
}

.saved-gps-btn {
  width: 100%;
  height: 52px;
  border-radius: 16px;
  background-color: #1E3A5F;
  border: 1px solid #3B82F6;
  justify-content: center;
  align-items: center;
  margin-top: 10px;
}

.saved-gps-text {
  color: #93C5FD;
  font-size: 20px;
  font-weight: bold;
}

.gps-status {
  font-size: 18px;
  color: #34D399;
  margin-top: 8px;
  text-align: center;
}

.preset-row {
  width: 100%;
  padding-left: 18px;
  padding-right: 18px;
  padding-top: 12px;
  padding-bottom: 12px;
  margin-bottom: 6px;
  background-color: #0F172A;
  border-radius: 16px;
  justify-content: space-between;
  align-items: center;
  border: 1px solid #1E293B;
}

.selected-row {
  border: 2px solid #10B981;
  background-color: #064E3B;
}

.city-info {
  flex-direction: column;
}

.city-name {
  font-size: 24px;
  color: #E2E8F0;
}

.city-country {
  font-size: 18px;
  color: #64748B;
  margin-top: 2px;
}

.method-name {
  font-size: 22px;
  color: #E2E8F0;
}

.selected-text {
  color: #FFFFFF;
  font-weight: bold;
}

.check-mark {
  font-size: 24px;
  color: #34D399;
  font-weight: bold;
}

.toggle-row {
  width: 100%;
  background-color: #111827;
  border-radius: 16px;
  padding: 16px;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.toggle-label {
  font-size: 22px;
  color: #E2E8F0;
}

.toggle-pill {
  padding-left: 16px;
  padding-right: 16px;
  padding-top: 6px;
  padding-bottom: 6px;
  border-radius: 14px;
}

.pill-on {
  background-color: #10B981;
}

.pill-off {
  background-color: #4B5563;
}

.pill-text {
  font-size: 18px;
  color: #FFFFFF;
  font-weight: bold;
}

.footer-wrap {
  width: 100%;
  justify-content: center;
  padding-top: 20px;
  padding-bottom: 60px;
}

.footer-info {
  font-size: 18px;
  color: #4B5563;
}
</style>
