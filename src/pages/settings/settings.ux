  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  align-items: center;
}

.scroll-container {
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding-left: 36px;
  padding-right: 36px;
  padding-top: 36px;
}

