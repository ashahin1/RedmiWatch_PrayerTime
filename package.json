{
  "name": "redmi-watch-prayer-time",
  "version": "1.0.0",
  "description": "Islamic Prayer Times standalone QuickApp for Xiaomi Redmi Watch 6 (HyperOS Vela RTOS)",
  "engines": {
    "node": ">=8.10"
  },
  "scripts": {
    "start": "aiot start --watch",
    "build": "aiot build",
    "release": "aiot release",
    "test": "node test/prayer-engine.test.js",
    "lint": "eslint --format codeframe --fix --ext .ux,.js src/"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{ux,js}": [
      "prettier --write",
      "eslint --format codeframe --fix",
      "git add"
    ],
    "*.{less,css}": [
      "prettier --write",
      "stylelint --fix --custom-syntax postcss-less",
      "git add"
    ]
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.3",
    "aiot-toolkit": "^2.0.5"
  }
}
